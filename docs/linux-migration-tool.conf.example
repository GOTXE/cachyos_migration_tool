# shellcheck shell=bash disable=SC2034
# Optional user config for migration.sh
# Suggested install path:
#   ~/.config/linux-migration-tool.conf
#
# Shell syntax is used intentionally, so arrays are supported.

# Extra home-relative config paths to include in backups.
# Examples:
# EXTRA_CONFIG_ITEMS+=("Scripts")
# EXTRA_CONFIG_ITEMS+=(".config/kitty")
# EXTRA_CONFIG_ITEMS+=(".local/share/applications")

# Extra directories to scan for Git repositories.
# Examples:
# EXTRA_REPO_SEARCH_DIRS+=("$HOME/Apps_Testing")
# EXTRA_REPO_SEARCH_DIRS+=("$HOME/dev")
# EXTRA_REPO_SEARCH_DIRS+=("/mnt/data/repos")

# Optional local repo override for codexBar Tray installer.
# Keep it empty unless the repo lives outside the standard search roots.
# Example:
# CODEXBAR_TRAY_REPO_DIR="$HOME/path/to/codexbar-tray"

# Extra user data directories to archive in backup/data.
# XDG Documents is included by default. Add others only if you want them copied
# outside the repo backup flow.
# Examples:
# DATA_DIRS+=("$HOME/Notes")
# DATA_DIRS+=("$HOME/Imágenes")
# DATA_DIRS+=("$HOME/Música")

EXTRA_CONFIG_ITEMS=(
    "Scripts"
)

EXTRA_REPO_SEARCH_DIRS=(
    "$HOME/Apps_Testing"
)

DATA_DIRS=()

# MBP Watch diagnostics
# MBP_WATCH_INTERVAL=5
# MBP_PLASMOID_TARGET="screen:1"
