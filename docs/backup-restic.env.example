# Example environment for Restic backups to a generic SFTP/SSH target.
# Copy to ~/.config/cachyos-migration-tool/backup.env and adjust values.
# Do not store this file with real secrets in git.

# Preferred target when the SFTP server is reachable from the local network.
BACKUP_SFTP_HOST_LAN="backup-sftp-lan"

# Fallback target when connected through VPN or another controlled remote path.
BACKUP_SFTP_HOST_REMOTE="backup-sftp-remote"

# Remote path on the SFTP server. This directory must be writable by the
# dedicated backup user.
BACKUP_SFTP_REPOSITORY_PATH="/srv/backups/workstation-linux/restic"

# Restic repository URLs derived from the SSH host aliases above.
RESTIC_REPOSITORY_LAN="sftp:${BACKUP_SFTP_HOST_LAN}:${BACKUP_SFTP_REPOSITORY_PATH}"
RESTIC_REPOSITORY_REMOTE="sftp:${BACKUP_SFTP_HOST_REMOTE}:${BACKUP_SFTP_REPOSITORY_PATH}"

# Local file containing the Restic encryption password.
# Create it manually with chmod 600. Do not reuse the remote user's password.
RESTIC_PASSWORD_FILE="$HOME/.config/cachyos-migration-tool/restic-password"

# Backup source. Scripts may narrow this further with include/exclude files.
BACKUP_SOURCE_HOME="$HOME"

# Suggested exclude file for Restic patterns.
BACKUP_EXCLUDES_FILE="$HOME/.config/cachyos-migration-tool/restic-excludes.txt"

# Retention focused on fast recovery from recent agent or development mistakes.
RESTIC_KEEP_HOURLY="24"
RESTIC_KEEP_DAILY="7"
RESTIC_KEEP_WEEKLY="4"
RESTIC_KEEP_MONTHLY="3"

# Connectivity check timeout in seconds before trying the next target.
BACKUP_CONNECT_TIMEOUT="8"
